<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 保存「生成图片」分享卡到相册：Android 10（API 29）及以下写外部存储需要；
         10+ 走 MediaStore 无需权限（见 lib/services/image_export.dart） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <!-- MCP 服务运行时的常驻状态通知（Android 13+ 需要，运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- MCP 运行状态前台服务（Android 14+ 需要声明服务类型对应的权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- 必须显式关闭预测性返回（android:enableOnBackInvokedCallback="false"）。
         原因：本 App targetSdk = 36（Flutter 3.44 默认值），而 Android 16+ 对
         targetSdk >= 36 的应用**默认开启**预测性返回，并停止调用 onBackPressed /
         派发 KEYCODE_BACK —— "不声明"不再等于"关闭"。
         开启预测性返回时，根 Tab 页无栈可退、且没有 PopScope(canPop:false)，
         框架会 setFrameworkHandlesBack(false) 把返回交给系统直接 finish，
         Dart 侧的 didPopRoute 不再被调用 —— 双击退出（global_shortcuts.dart）
         会被整个跳过，表现为"按一次返回就退出"。
         Android 13/14/15 上显式 false 与原先"不声明"行为一致，仅 Android 16+
         恢复旧版返回派发，因此这行不能删。 -->
    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- 关闭 Flutter 自带的 deep link 处理（3.27 起默认开启）。
                 它会把 intent 里的**完整 URL** 直接交给 GoRouter：冷启动当
                 initialRoute、热启动走 RouteInformation 运行时推送，两者都会
                 让 GoRouter 拿论坛 URL 去匹配路由表 → "no routes for location"。
                 入站链接统一由 Dart 侧 AppLink + UrlRouter 处理，故在此关闭。 -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 论坛链接的"打开方式"：在浏览器/其他应用点论坛帖子时可选 MTBBS 打开。
                 只登记当前主站（MT 论坛 bbs.binmt.cc）——其它站点尚未适配，用户点开
                 也无法日用，因此不在此声明。
                 不配 autoVerify 是为了始终走"选择打开方式"而不依赖服务器放 assetlinks.json。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:host="bbs.binmt.cc"/>
            </intent-filter>
        </activity>
        <!-- MCP 运行状态前台服务：仅持有常驻通知，端口在 Flutter 侧。
             stopWithTask=true：从最近任务划掉 App 时立即停止服务、撤掉通知。
             前台服务的 stopWithTask 默认为 false，不加这一行则服务会在"退出应用"后
             继续存活，留下假通知（见 docs/07 #65）。 -->
        <service
            android:name=".McpForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="dataSync"/>

        <!-- 注入文件提供器（system SAF DocumentsProvider）：
             让 MT 管理器 / 系统「文件」在**无需 ROOT** 的情况下浏览本应用私有目录，
             便于排查数据库、Cookie、缓存等问题。使用说明见 docs/29。

             两处刻意设计，改动前请先读 docs/29：
             1. android:enabled="false"：默认**不注册**。provider 一旦常驻，任何能拉起
                系统文件选择器的应用都能诱导用户点一下授权，而我们的私有目录里有
                登录 Cookie。用户必须在「设置 → 存储与工具 → 注入文件提供器」里主动打开，
                此时由 AppDataFilesBridge 调 setComponentEnabledSetting 启用
                （DONT_KILL_APP，不杀进程）。
             2. android:permission="android.permission.MANAGE_DOCUMENTS"：signature 级
                权限，只有系统 DocumentsUI 持有。第三方不能直接 query 本 provider，
                必须由用户在系统选择器里选中本应用后才拿到 URI 授权 —— 安全边界靠它，
                不要为了"方便调试"去掉。
             authorities 用 ${applicationId} 前缀，三个变体（正式/debug/beta）互不冲突。 -->
        <provider
            android:name=".AppDataFilesProvider"
            android:authorities="${applicationId}.MTDataFilesProvider"
            android:enabled="false"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- 配套的空 Activity：provider 跑在本进程里，进程被系统回收后第三方查询会
             拿到 "provider not found"，MT 在查询前会先尝试拉起这样一个 Activity。
             不显示界面、立即 finish；excludeFromRecents + noHistory 保证不在最近
             任务里留痕。与 provider 一起受上面的开关控制（同一个 enabled=false）。 -->
        <activity
            android:name=".AppDataFilesWakeUpActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.AppDataFilesWakeUp" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
